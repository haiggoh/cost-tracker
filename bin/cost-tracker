#!/usr/bin/env python3
"""cost-tracker — what did today cost, and on which axis?

THE ONE RULE: every dollar figure this tool prints names its own membership.
An unlabelled dollar figure is the bug this tool exists to prevent. On
2026-08-10 a spend line labelled "prior sessions" silently included the
running session and so under-counted ~$14 of $18.16; the label had inferred
membership from session age instead of stating what it summed. So:

  THREE AXES, ALWAYS LABELLED
    session   one Claude Code session's LIFETIME cost (may span UTC days)
    today     gateway spend across ALL sessions with an entry on one UTC day
    local     localhost inference — free compute, reported as savings, never
              added to cloud spend

Reads (never writes) two stores produced by the statusline capture wrapper:

  ~/.claude/cost-ledger/<session_id>   one line, latest render wins
        "<utc_date> <cum> [<baseline>] [<local_phantom_cum>]"
  ~/.claude/cost-ledger-history.log    append-only, one line per render
        "<iso_ts> <session_id> <utc_date> <cum> <baseline> [<raw_cost>]"

The per-session file is OVERWRITTEN every render, so it can only answer
"today". Any longer period comes from the history log, grouped by
(session_id, utc_date) with the LAST row per group winning — never by adding
rows, and never by adding into an assumed-membership subtotal.

Structurally invalid records are QUARANTINED with a visible reason, never
counted as a session and never silently dropped. `doctor` prints them.

Environment overrides (all optional):
  COST_TRACKER_LEDGER_DIR   default ~/.claude/cost-ledger
  COST_TRACKER_HISTORY      default ~/.claude/cost-ledger-history.log
  COST_TRACKER_CAP_USD      daily cap; falls back to BUDGET_TALLY_CAP_USD, then unset
  COST_TRACKER_TODAY        override "today" as YYYY-MM-DD (tests)
  COST_TRACKER_SAVINGS_CMD  argv (shell-split) printing savings-ledger JSON
"""
import argparse
import glob
import json
import os
import re
import shlex
import subprocess
import sys
from collections import defaultdict
from datetime import date, datetime, timedelta, timezone

CONTRACT = 1

DATE_RE = re.compile(r"^\d{4}-\d{2}-\d{2}$")

LEDGER_DIR = os.environ.get(
    "COST_TRACKER_LEDGER_DIR", os.path.expanduser("~/.claude/cost-ledger")
)
HISTORY_PATH = os.environ.get(
    "COST_TRACKER_HISTORY", os.path.expanduser("~/.claude/cost-ledger-history.log")
)
TODAY = os.environ.get("COST_TRACKER_TODAY") or datetime.now(timezone.utc).date().isoformat()


# --- the cap: learned from the gateway's own refusal -------------------------
# The gateway will not TELL us the cap (/key/info is 403 for a virtual key scoped to
# llm_api_routes) but it SHOUTS it the moment the cap is hit:
#
#   API Error: Request rejected (429) · Budget has been exceeded!
#   Key=Joyia-Code-M4m (sk-...YxHg) Current cost: 40.11333501999997, Max budget: 40.0
#
# That message is persisted into the transcript as an assistant turn, so the cap is
# READABLE after all — just from the refusal rather than from an API. The most recent
# observation is the cap until a newer refusal says otherwise.
#
# Only the per-KEY scope is usable as a daily denominator. The same message shape also
# carries `Team=<uuid>` for the SHARED team cap (historically 1300 → 1400), and using
# that as a personal daily cap would divide by a number 35x too large. Scope is
# therefore recorded and filtered on, never assumed.
KILL_RE = re.compile(
    r"Budget has been exceeded!\s*"
    r"(?P<scope>Key|Team)=(?P<label>[^\s(]+)"
    r"(?:\s*\((?P<keyhint>[^)]*)\))?"
    r"\s*Current cost:\s*(?P<cost>[0-9]+(?:\.[0-9]+)?)\s*,\s*"
    r"Max budget:\s*(?P<cap>[0-9]+(?:\.[0-9]+)?)"
)

CONFIG_DIR = os.environ.get(
    "COST_TRACKER_CONFIG_DIR", os.path.expanduser("~/.claude/cost-tracker")
)
CONFIG_PATH = os.path.join(CONFIG_DIR, "cap.json")
TRANSCRIPTS_DIR = os.environ.get(
    "COST_TRACKER_PROJECTS_DIR", os.path.expanduser("~/.claude/projects")
)


def read_config():
    try:
        with open(CONFIG_PATH) as f:
            data = json.load(f)
    except (OSError, json.JSONDecodeError):
        return None
    return data if isinstance(data, dict) else None


def write_config(data):
    """Best-effort: a cap we cannot cache is a cap we look up again, not an error."""
    try:
        os.makedirs(CONFIG_DIR, exist_ok=True)
        tmp = CONFIG_PATH + ".tmp"
        with open(tmp, "w") as f:
            json.dump(data, f, indent=2, ensure_ascii=False)
            f.write("\n")
        os.replace(tmp, CONFIG_PATH)      # atomic: a reader never sees half a file
        return True
    except OSError:
        return False


def find_refusals(max_files=500, since_days=365):
    """EVERY genuine refusal in the transcripts, oldest first.

    `learn_cap` wants only the newest observation per scope; CALIBRATION wants all of
    them, because each refusal is a free measurement of the true cumulative on its own
    day. One scan serves both so the two can never disagree about what counts as a
    refusal — in particular about the poisoned-source filter below.

    Bounded on purpose: newest-mtime-first, a file limit and an age limit, because this
    reads whole transcripts and must stay a rare operation. NEVER called from the
    statusline path.
    """
    cutoff = (datetime.now(timezone.utc) - timedelta(days=since_days)).isoformat()
    paths = []
    for pat in ("*/*.jsonl", "*.jsonl"):
        paths.extend(glob.glob(os.path.join(TRANSCRIPTS_DIR, pat)))
    try:
        paths.sort(key=lambda p: os.path.getmtime(p), reverse=True)
    except OSError:
        pass
    paths = paths[:max_files]
    observations = []
    scanned = 0
    for path in paths:
        try:
            f = open(path, "r", errors="ignore")
        except OSError:
            continue
        scanned += 1
        with f:
            for line in f:
                # cheap substring reject first: parsing every transcript line as JSON
                # to find a rare error turn is orders of magnitude slower.
                if "Budget has been exceeded" not in line:
                    continue
                m = KILL_RE.search(line)
                if not m:
                    continue
                try:
                    d = json.loads(line)
                except (json.JSONDecodeError, AttributeError):
                    continue
                # ONLY a real refusal counts. `isApiErrorMessage` is set by Claude Code
                # on the turn it writes for a rejected request; PROSE that merely quotes
                # the message — a note, a plan, an assistant explaining a past kill — has
                # no such marker. This matters: the first probe of this learner picked up
                # the error text out of the very session that was investigating it, and
                # would have "learned" the cap from a sentence rather than from the
                # gateway. Any conversation ABOUT a budget kill is a poisoned source.
                if d.get("isApiErrorMessage") is not True:
                    continue
                ts = d.get("timestamp") or ""
                scope = m.group("scope").lower()
                obs = {
                    "cap_usd": float(m.group("cap")),
                    "cost_at_kill_usd": float(m.group("cost")),
                    "scope": scope,
                    "label": m.group("label"),
                    "key_hint": m.group("keyhint") or "",
                    "observed_at": ts,
                    "source_file": os.path.basename(path),
                    "raw": m.group(0)[:300],
                }
                # The age limit the docstring promises: an observation older than the
                # cutoff is not evidence about the cap we are under today.
                if ts and ts < cutoff:
                    continue
                observations.append(obs)
    observations.sort(key=lambda o: o["observed_at"] or "")
    return {"observations": observations, "files_scanned": scanned,
            "files_available": len(paths)}


def learn_cap(max_files=500, since_days=365):
    """The newest refusal per scope, as a cacheable config record.

    Returns a dict (never written here — the caller decides) with the observation and its
    provenance, or a `found: false` record. A file's mtime only approximates its records'
    timestamps, so the winner is chosen by the RECORD's own timestamp across everything
    scanned, not by file order.
    """
    found = find_refusals(max_files=max_files, since_days=since_days)
    best = {}          # scope -> observation
    for obs in found["observations"]:
        prev = best.get(obs["scope"])
        if prev is None or (obs["observed_at"] or "") >= (prev["observed_at"] or ""):
            best[obs["scope"]] = obs
    return {
        "contract": 1,
        "learned_at": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
        "files_scanned": found["files_scanned"],
        "files_available": found["files_available"],
        "found": bool(best.get("key")),
        "key": best.get("key"),
        "team": best.get("team"),
    }


def learned_cap(auto_learn=False):
    """The learned per-key cap and its provenance, or (None, provenance-or-None).

    auto_learn=True performs the ONE first-run scan when no config exists yet. The
    result is written even when nothing was found, so a machine that has never hit the
    cap does not re-scan every transcript on every invocation. `cap --learn` re-scans on
    demand; that is what "the daily budget cap changed" should run.
    """
    cfg = read_config()
    if cfg is None and auto_learn:
        cfg = learn_cap()
        write_config(cfg)
    if not cfg:
        return None, None
    key = cfg.get("key")
    if not key or not key.get("cap_usd"):
        return None, cfg
    return float(key["cap_usd"]), cfg


# --- the gateway markup -------------------------------------------------------
# Claude Code's own `total_cost_usd` prices tokens at Anthropic LIST rates, and it is
# RIGHT: reconstructing a session from its own usage records reproduces that figure (one
# session measured 0.9996 of it, median 1.0207 across 14). We report that number
# faithfully. A RESELLING GATEWAY (LiteLLM and friends) may nonetheless bill a different
# amount for the same tokens, and then the ledger is accurate about cost while being
# useless as a predictor of the refusal — the only number that actually stops the work.
#
# So the markup is deliberately NOT a correction to our figure. It is a second,
# separately-labelled axis, learned from external evidence, and its DEFAULT IS EXACTLY
# 1.0 — meaning ordinary first-party Claude Code (no gateway, no cap, no refusals ever)
# resolves identity, renders byte-identical output, and cannot acquire a markup, because
# the only thing it can be learned from is a gateway refusal message that will never
# exist. Compatibility here is structural, not a flag someone has to remember to unset.

MARKUP_MIN_DAYS = 5          # below this, one odd day sets the factor
MARKUP_MAX_CV = 0.25         # above this the ratio is noise, not a rate
MARKUP_IDENTITY = 1.0


def _median(xs):
    s = sorted(xs)
    if not s:
        return None
    mid = len(s) // 2
    return s[mid] if len(s) % 2 else (s[mid - 1] + s[mid]) / 2.0


def measure_markup(cal):
    """What this gateway bills per dollar of list price, from `calibrate` rows.

    MEDIAN of the per-day gateway/ours ratios, not a ratio of the sums: a single
    partially-covered day would otherwise drag the rate, and the whole point is a figure
    steady enough to trust.

    The CV gate is what makes this honest. A markup is a claim that ONE multiplicative
    constant explains the gap; if the per-day ratios scatter, that claim is false and the
    right answer is to learn nothing rather than to publish an average of unlike things.
    Measured on the machine this was built on: 19 days, ratios 1.205-1.289, CV 0.0525 —
    well inside the gate, and 4x tighter as a multiplicative model (CV 0.0178) than as an
    additive one (0.0752), which is the evidence that it IS a rate and not a fixed fee.
    """
    ratios = [r["gateway_usd"] / r["ours_usd"]
              for r in cal.get("days", [])
              if r.get("verdict") != "no-data" and r.get("ours_usd")
              and r.get("gateway_usd")]
    n = len(ratios)
    if not n:
        return {"factor": None, "n_days": 0, "cv": None,
                "reason": "no calibrated day has both a gateway figure and one of ours"}
    med = _median(ratios)
    mean = sum(ratios) / n
    var = sum((x - mean) ** 2 for x in ratios) / n
    cv = (var ** 0.5 / mean) if mean else None
    out = {"factor": round(med, 4), "n_days": n,
           "cv": (round(cv, 4) if cv is not None else None),
           "ratio_min": round(min(ratios), 4), "ratio_max": round(max(ratios), 4),
           "reason": None}
    if n < MARKUP_MIN_DAYS:
        out["reason"] = (f"only {n} calibrated day(s); needs {MARKUP_MIN_DAYS} before one "
                         "day stops being able to set the rate")
    elif cv is not None and cv > MARKUP_MAX_CV:
        out["reason"] = (f"the per-day ratios scatter too much (CV {cv:.3f} > "
                         f"{MARKUP_MAX_CV}) to be a single rate")
    elif med is not None and med < 1.0:
        # Ours ABOVE the gateway is not a markup. A refusal is a lower bound on the day,
        # so this is the expected shape of a well-behaved account, not a discount.
        out["reason"] = ("we already report at or above the gateway — nothing to mark up")
    return out


def learned_markup():
    """(factor, provenance) from the config file, or (None, None). Never scans."""
    cfg = read_config()
    if not cfg:
        return None, None
    m = cfg.get("markup")
    if not isinstance(m, dict) or not m.get("factor"):
        return None, cfg
    try:
        f = float(m["factor"])
    except (TypeError, ValueError):
        return None, cfg
    return (f, cfg) if f > 0 else (None, cfg)


def markup_factor():
    """What the gateway bills per dollar we report. 1.0 unless PROVEN otherwise.

    Resolution order, most explicit first:
      1. COST_TRACKER_MARKUP — a deliberate override always wins (and `1` disables).
      2. the factor learned by `calibrate --learn-markup` from refusal evidence.
      3. 1.0 — identity. No gateway, no evidence, no adjustment, unchanged output.
    """
    raw = os.environ.get("COST_TRACKER_MARKUP")
    if raw:
        try:
            v = float(raw)
            if v > 0:
                return v
        except ValueError:
            pass
    f, _cfg = learned_markup()
    return f if f else MARKUP_IDENTITY


def cap_usd(auto_learn=False):
    """The daily cap, or None. None is a real answer, not zero.

    Resolution order, most explicit first:
      1. COST_TRACKER_CAP_USD / BUDGET_TALLY_CAP_USD — a deliberate override always wins.
      2. the cap LEARNED from the gateway's own refusal message (see learn_cap).
      3. None — spend prints with no denominator rather than an invented one.
    Never probes the network, and never scans transcripts unless auto_learn is set, so
    the statusline path stays cheap.
    """
    for var in ("COST_TRACKER_CAP_USD", "BUDGET_TALLY_CAP_USD"):
        raw = os.environ.get(var)
        if raw:
            try:
                v = float(raw)
            except ValueError:
                continue
            if v > 0:
                return v
    cap, _cfg = learned_cap(auto_learn=auto_learn)
    return cap


# --- parsing -----------------------------------------------------------------

class Record:
    """One parsed ledger record. `valid` False means QUARANTINED with a reason."""

    __slots__ = ("session_id", "valid", "reason", "day", "cum", "baseline",
                 "phantom", "axis", "raw", "reset_anchored")

    def __init__(self, session_id, raw, valid, reason="", day=None, cum=0.0,
                 baseline=0.0, phantom=None, axis="", reset_anchored=False):
        self.session_id = session_id
        self.raw = raw
        self.valid = valid
        self.reason = reason
        self.day = day
        self.cum = cum
        self.baseline = baseline
        self.phantom = phantom
        self.axis = axis
        # True when the session's own cumulative RESET below its carried-in baseline —
        # a resumed session, whose spend is anchored at the reset instead.
        self.reset_anchored = reset_anchored

    @property
    def day_usd(self):
        """Spend attributable to self.day — the delta over the baseline carried
        into that day. NOT the lifetime cumulative: charging a multi-day
        session's whole lifetime to the day it last rendered once showed a
        4-day $75 session as 189% of a $40 cap.

        RESET-ANCHORED case: when a session is RESUMED, Claude Code's
        total_cost_usd restarts at 0, so the incoming cumulative can be BELOW the
        baseline carried into the day. The baseline then describes a counter that
        no longer exists, and the spend accrued since the reset is the cumulative
        itself. Subtracting the stale baseline yields a negative number; clamping
        that to 0 (what budget-tally did) reports the day as free. Measured on
        session e4d10d09, 2026-08-26: cumulative reached $16.07 against a stale
        baseline of $17.35, so the day was reported as $0.00. Anchoring at the
        reset recovers it. The known cost is that any spend EARLIER the same day,
        before the reset, is not recoverable from the ledger — so this figure is a
        floor, and it is labelled as one wherever it is printed."""
        if not self.valid or self.axis in ("local", "zero"):
            return 0.0
        if self.reset_anchored:
            return self.cum
        return self.cum - self.baseline

    @property
    def lifetime_usd(self):
        """The session axis: cumulative cost since the session began."""
        if not self.valid or self.axis == "local":
            return 0.0
        return self.cum


def _valid_date(s):
    if not DATE_RE.match(s):
        return False
    try:
        date.fromisoformat(s)
    except ValueError:
        return False       # shape-valid but not a real date, e.g. 2026-13-45
    return True


def parse_ledger_fields(session_id, fields, raw):
    """Apply the validation rules in a fixed order, so a record with two
    problems always reports the same one."""
    if len(fields) < 2:
        return Record(session_id, raw, False, "too-few-fields")
    if len(fields) > 4:
        return Record(session_id, raw, False, "too-many-fields")
    if not _valid_date(fields[0]):
        # A history line starts with an ISO timestamp and lands here — which is
        # why history is kept OUTSIDE the ledger dir. Structural, not luck.
        return Record(session_id, raw, False, "bad-date")
    nums = []
    for f in fields[1:]:
        try:
            nums.append(float(f))
        except ValueError:
            return Record(session_id, raw, False, "non-numeric")
    cum = nums[0]
    baseline = nums[1] if len(nums) >= 2 else 0.0
    phantom = nums[2] if len(nums) >= 3 else None
    if cum < 0 or baseline < 0:
        return Record(session_id, raw, False, "negative-cost")
    # A cumulative BELOW its own carried-in baseline is not corruption, and this is
    # the whole reason the earlier "baseline-exceeds-cumulative" quarantine existed:
    # cum is a lifetime cumulative, so it can only fall if the COUNTER RESTARTED.
    # Two distinct restarts, told apart by whether any spend is reported at all:
    #
    #   cum == 0, baseline > 0  -> a zero-cost render. AMBIGUOUS before 2026-08-29:
    #       either a local render (the endpoint gate zeroes the cost) or a resumed
    #       session whose counter has restarted but not yet billed a turn. Field 4
    #       disambiguates it, and field 4 did not exist before that date — so a
    #       3-field zero is honestly `zero`, not asserted to be local. Either way it
    #       contributes $0.
    #   0 < cum < baseline      -> a RESUMED session, counter restarted and already
    #       billing. Measured on sessions 960b07ca (2026-08-24) and e4d10d09
    #       (2026-08-26). The baseline now describes a counter that no longer exists,
    #       so the day is anchored at the reset — see Record.day_usd.
    ambiguous_zero = (cum == 0.0 and baseline > 0.0 and phantom is None)
    counter_reset = (0.0 < cum < baseline)
    if phantom is not None and cum == 0.0:
        axis = "local"                 # field 4 present: unambiguously a local render
    elif ambiguous_zero:
        axis = "zero"
    else:
        axis = "cloud"
    return Record(session_id, raw, True, "", fields[0], cum, baseline, phantom, axis,
                  reset_anchored=counter_reset)


def parse_ledger_line(session_id, text):
    fields = text.split()
    return parse_ledger_fields(session_id, fields, text.strip())


def read_ledger():
    """Every record currently in the ledger dir, valid or quarantined."""
    out = []
    try:
        names = sorted(os.listdir(LEDGER_DIR))
    except OSError:
        return out
    for name in names:
        if name.endswith(".tmp") or name.startswith("."):
            continue
        path = os.path.join(LEDGER_DIR, name)
        try:
            if not os.path.isfile(path):
                continue
            with open(path, "r", errors="ignore") as f:
                text = f.read()
        except OSError:
            continue
        if not text.strip():
            out.append(Record(name, "", False, "empty"))
            continue
        out.append(parse_ledger_line(name, text))
    return out


def read_history():
    """Group history rows by (session_id, utc_date), LAST row per group wins.

    Rows are cumulative snapshots, so summing rows would multiply-count a
    session by however many times its statusline rendered. Grouping is the
    whole point: D15's rule is group by (session_id, UTC day) and sum groups.
    """
    groups = {}
    quarantined = []
    # A reset is only fully visible in the ROW SEQUENCE. Anchoring on the final row
    # alone misses the case where the counter restarted mid-day and then climbed back
    # ABOVE the stale baseline before the last render — session 960b07ca on 2026-08-24
    # went 0 -> 1.11 -> 3.68 -> 15.998 against a baseline of 3.614, so its final row
    # looks ordinary and the day was under-counted by exactly that stale $3.61. Per
    # (session, day) we therefore remember the highest cumulative seen and whether it
    # ever went DOWN. Rows with cum == 0 are skipped: a local render legitimately
    # reports 0 and would otherwise look like a reset on every single row.
    peak = {}
    reset_seen = set()
    try:
        f = open(HISTORY_PATH, "r", errors="ignore")
    except OSError:
        return groups, quarantined
    with f:
        for lineno, line in enumerate(f, 1):
            line = line.strip()
            if not line:
                continue
            parts = line.split()
            if len(parts) < 5:
                quarantined.append((lineno, "too-few-fields", line))
                continue
            _ts, sid, day = parts[0], parts[1], parts[2]
            rec = parse_ledger_fields(sid, [day] + parts[3:5], line)
            if not rec.valid:
                quarantined.append((lineno, rec.reason, line))
                continue
            # field 6 (raw pre-gate cost) marks a local render: cost was zeroed
            # but the phantom kept accruing, so the axis is legible after the fact.
            if len(parts) >= 6:
                try:
                    raw_cost = float(parts[5])
                except ValueError:
                    raw_cost = 0.0
                if rec.cum == 0.0 and raw_cost > 0:
                    rec.axis = "local"
            key = (sid, day)
            if rec.cum > 0.0:
                if rec.cum < peak.get(key, 0.0):
                    reset_seen.add(key)
                peak[key] = max(peak.get(key, 0.0), rec.cum)
            if rec.reset_anchored:
                reset_seen.add(key)
            groups[key] = rec              # later line wins
    for key in reset_seen:
        if key in groups:
            groups[key].reset_anchored = True
    return groups, quarantined


# --- savings (the local axis) -------------------------------------------------

def read_savings_fast():
    """Today's savings read straight from the DERIVED rollup — no subprocess.

    The statusline path cannot afford to spawn the savings ledger on every render, and
    the rollup exists precisely so a status line can read it without parsing a growing
    log. Staleness is checked rather than assumed: the rollup records the event count it
    was built from, so a log that has grown since means the rollup is behind and the
    honest answer is None (unmeasured), not a stale number presented as current.
    """
    d = os.environ.get("LOCAL_AGENTS_LEDGER_DIR") or os.path.expanduser("~/.claude/local-agents")
    rollup, events = os.path.join(d, "rollup.json"), os.path.join(d, "savings.jsonl")
    try:
        with open(rollup) as f:
            data = json.load(f)
    except (OSError, json.JSONDecodeError):
        return None
    if not isinstance(data, dict) or "rows" not in data:
        return None
    try:
        with open(events, errors="ignore") as f:
            n = sum(1 for line in f if line.strip())
    except OSError:
        n = None
    if n is not None and data.get("source_events") != n:
        return None                      # rollup is behind the log: unmeasured, not stale
    total, count = 0.0, 0
    for row in data.get("rows") or []:
        if row.get("day") != TODAY:
            continue
        if row.get("saved_usd") is None:
            continue
        total += float(row["saved_usd"])
        count += int(row.get("events") or 0)
    return {"saved_usd": round(total, 4), "events": count}


def read_savings(period_flag):
    """Savings from the local-agents savings ledger, or None if unavailable.

    None is not zero. Zero saved is a claim that local work happened and was
    worth nothing; None says nothing measured it. Reporting an absent ledger
    as $0.00 understates savings forever and looks correct while doing it.
    """
    cmd = os.environ.get("COST_TRACKER_SAVINGS_CMD")
    if cmd:
        argv = shlex.split(cmd)
    else:
        found = _find_savings_ledger()
        if not found:
            return None
        argv = [sys.executable, found]
    argv = argv + ["report", period_flag, "--json"]
    try:
        proc = subprocess.run(argv, capture_output=True, text=True, timeout=20)
    except (OSError, subprocess.SubprocessError):
        return None
    if proc.returncode != 0 or not proc.stdout.strip():
        return None
    try:
        data = json.loads(proc.stdout)
    except json.JSONDecodeError:
        return None
    if not isinstance(data, dict) or "saved_usd" not in data:
        return None
    return data


def _find_savings_ledger():
    import glob as _glob
    roots = [
        os.path.expanduser("~/ClaudeWorkspace/local-agents/bin/savings-ledger.py"),
    ]
    roots += sorted(_glob.glob(os.path.expanduser(
        "~/.claude/plugins/cache/*/local-agents/*/bin/savings-ledger.py")), reverse=True)
    for p in roots:
        if os.path.isfile(p):
            return p
    return None


# --- periods ------------------------------------------------------------------

PERIODS = {
    "today": ("today", "--today"),
    "week": ("last 7 days", "--week"),
    "month": ("last 30 days", "--month"),
}


def period_days(period, since=None):
    """The inclusive list of UTC dates a period covers, newest last."""
    today = date.fromisoformat(TODAY)
    if since:
        start = date.fromisoformat(since)
    elif period == "week":
        start = today - timedelta(days=6)
    elif period == "month":
        start = today - timedelta(days=29)
    else:
        start = today
    if start > today:
        start = today
    days, d = [], start
    while d <= today:
        days.append(d.isoformat())
        d += timedelta(days=1)
    return days


def _merged_records(fast=False):
    """(session_id, day) -> Record for everything on record, plus the quarantine list.

    Shared by collect() and daily_totals() ON PURPOSE: the calibration harness compares
    our daily figure against the gateway's, and that comparison is worthless if the
    reported total and the calibrated total are assembled by two different code paths.
    """
    ledger = read_ledger()
    # FAST PATH (statusline): the per-session ledger dir alone answers "today", so the
    # history log — hundreds of thousands of lines on a long-lived machine — is not read
    # at all. It is only needed for periods the overwritten ledger file cannot describe.
    if fast:
        hist_groups, hist_bad = {}, []
    else:
        hist_groups, hist_bad = read_history()

    quarantined = [
        {"source": "ledger", "session_id": r.session_id, "reason": r.reason, "raw": r.raw}
        for r in ledger if not r.valid
    ]
    quarantined += [
        {"source": f"history:{lineno}", "session_id": "", "reason": reason, "raw": raw}
        for lineno, reason, raw in hist_bad
    ]

    # (session_id, day) -> record. History first, then let the live ledger win
    # for the day it describes: it is the newest render of that session.
    merged = dict(hist_groups)
    for r in ledger:
        if not r.valid:
            continue
        key = (r.session_id, r.day)
        # The ledger line is the NEWEST render, so it wins on the numbers — but it is a
        # single line and cannot show a reset that happened earlier in the day and then
        # climbed back above the stale baseline. That is a fact about the day, observable
        # only in the row sequence, so carry the flag forward instead of letting the
        # overwrite erase it. Without this, session 960b07ca's 2026-08-24 reset was
        # detected in history and then immediately forgotten.
        prior = merged.get(key)
        if prior is not None and prior.reset_anchored:
            r.reset_anchored = True
        merged[key] = r
    return merged, quarantined


def collect(period="today", since=None, fast=False, days=None):
    """Build the report data. Membership is explicit in every field name.

    `days` overrides the period with an explicit set of UTC dates — how the calibration
    harness asks for one past day at a time.
    """
    if days is not None:
        days = set(days)
        label = (sorted(days)[0] if len(days) == 1
                 else f"{min(days)} … {max(days)}")
    else:
        days = set(period_days(period, since))
        label = PERIODS.get(period, (period, ""))[0] if not since else f"since {since}"
    merged, quarantined = _merged_records(fast=fast)

    per_session_day = {k: v for k, v in merged.items() if k[1] in days}

    sessions = defaultdict(lambda: {"period_usd": 0.0, "lifetime_usd": 0.0,
                                    "days": [], "axis": "cloud",
                                    "reset_anchored": False})
    for (sid, day), rec in sorted(per_session_day.items()):
        s = sessions[sid]
        s["period_usd"] += rec.day_usd
        # lifetime is a cumulative, so the LARGEST seen is the session's total —
        # never a sum of per-day cumulatives.
        s["lifetime_usd"] = max(s["lifetime_usd"], rec.lifetime_usd)
        s["days"].append(day)
        if rec.reset_anchored:
            s["reset_anchored"] = True
        if rec.axis in ("local", "zero") and s["period_usd"] == 0.0:
            s["axis"] = rec.axis

    cloud_total = sum(s["period_usd"] for s in sessions.values())
    local_sessions = [sid for sid, s in sessions.items() if s["axis"] == "local"]
    zero_sessions = [sid for sid, s in sessions.items() if s["axis"] == "zero"]
    reset_sessions = [sid for sid, s in sessions.items() if s["reset_anchored"]]
    if fast:
        savings = read_savings_fast()
    else:
        savings = read_savings(PERIODS.get(period, ("", "--today"))[1] if not since
                              else "--since=" + since)

    cap = cap_usd(auto_learn=not fast)
    cap_source = "unset"
    if cap is not None:
        if os.environ.get("COST_TRACKER_CAP_USD") or os.environ.get("BUDGET_TALLY_CAP_USD"):
            cap_source = "env override"
        else:
            cap_source = "learned from a budget-kill message"
    markup = markup_factor()
    if os.environ.get("COST_TRACKER_MARKUP"):
        markup_source = "env override"
    elif markup != MARKUP_IDENTITY:
        markup_source = "measured against the gateway's own figures"
    else:
        markup_source = "none (list price — no gateway markup measured)"
    return {
        "contract": CONTRACT,
        "period": label,
        "period_days_utc": sorted(days),
        "today_utc": TODAY,
        "membership": ("all sessions with a ledger or history entry on "
                       + ("this UTC day" if len(days) == 1 else "these UTC days")),
        "cloud_usd": round(cloud_total, 4),
        "cap_usd": cap,
        "cap_source": cap_source,
        "pct_of_cap": (round(cloud_total / cap, 4) if cap else None),
        # The gateway axis. ADDITIVE keys: `cloud_usd` and `pct_of_cap` keep their exact
        # prior meaning (what Claude Code says the tokens cost, at list price), so every
        # existing consumer is unaffected. At the identity factor these say 1.0 / the same
        # figure / the same percentage, which is why a first-party user sees no change.
        "markup": markup,
        "markup_source": markup_source,
        "billed_usd": round(cloud_total * markup, 4),
        "billed_pct_of_cap": (round(cloud_total * markup / cap, 4) if cap else None),
        # The cap expressed in OUR units: the figure our own total may reach before the
        # gateway refuses. With no markup this is just the cap.
        "effective_cap_usd": (round(cap / markup, 4) if cap else None),
        "sessions": {sid: {"period_usd": round(s["period_usd"], 4),
                           "lifetime_usd": round(s["lifetime_usd"], 4),
                           "days": s["days"], "axis": s["axis"],
                           "reset_anchored": s["reset_anchored"]}
                     for sid, s in sorted(sessions.items())},
        "local_sessions": sorted(local_sessions),
        "zero_sessions": sorted(zero_sessions),
        "reset_anchored_sessions": sorted(reset_sessions),
        "local_saved_usd": (savings.get("saved_usd") if savings else None),
        "local_events": (savings.get("events") if savings else None),
        "quarantined": quarantined,
    }


# --- calibration against the gateway's own figure -----------------------------
# The daily total has been wrong in BOTH directions and was internally consistent every
# time, so internal consistency is not evidence. A refusal states `Current cost` — the
# cumulative FOR THE KEY in the current budget window, which is exactly the `today` axis.
# That makes every refusal a free, external measurement of a day we can check ourselves
# against, and there are 119 of them across 37 UTC days on the machine this was built on.
#
# Direction matters: a refusal is a LOWER BOUND (it names the cumulative at that instant,
# and the day can overshoot — $43.17 is on record). So ours-below-gateway is a defect;
# ours-above is not.

STALE_REPEAT_WINDOW_MIN = 30     # reset propagation lag, measured at ~5-10 min
CENT = 0.005                     # "the same figure" for two floats printed to the cent


def _minutes_into_utc_day(ts):
    """Minutes past 00:00 UTC, or None if the timestamp is unusable."""
    try:
        return int(ts[11:13]) * 60 + int(ts[14:16])
    except (ValueError, IndexError, TypeError):
        return None


def gateway_totals(observations, stale_window_min=STALE_REPEAT_WINDOW_MIN):
    """Per UTC day: the highest cumulative the GATEWAY itself stated, and how it got it.

    Two things that would otherwise manufacture false findings:

    REPEATS. Once blocked, every further request re-reports the same cached cumulative —
    14 of them on 2026-08-24. They are one measurement, not fourteen.

    THE POST-MIDNIGHT REPEAT. The budget window resets at 00:00 UTC but propagation lags
    minutes, so a refusal just after midnight restates YESTERDAY's cumulative. Counted as
    the new day's ground truth it invents a ~$40 reference for a day that has barely
    spent anything — a phantom undercount on every such day, which is precisely the
    finding this harness exists to report honestly. Confirmed instances: 2026-07-31T00:05
    and 2026-08-21T00:00, both repeating the prior day to the cent. The rule keys on the
    VALUE repeating as well as the clock, because a genuine post-reset kill the same night
    states a DIFFERENT figure and is real data (2026-08-21T00:06 does exactly that).

    Only the per-KEY scope is a personal daily reference; `Team=` carries the shared cap
    (1400), and using it would call every day a $1400 undercount.
    """
    by_day = defaultdict(list)
    for obs in observations:
        if obs.get("scope") != "key":
            continue
        ts = obs.get("observed_at") or ""
        if not _valid_date(ts[:10]):
            continue
        by_day[ts[:10]].append(obs)

    out = {}
    for day in sorted(by_day):
        prev_cal_day = (date.fromisoformat(day) - timedelta(days=1)).isoformat()
        ref = out.get(prev_cal_day, {}).get("gateway_usd")
        fresh, stale = [], []
        for obs in by_day[day]:
            mins = _minutes_into_utc_day(obs.get("observed_at") or "")
            if (ref is not None and mins is not None and mins <= stale_window_min
                    and abs(obs["cost_at_kill_usd"] - ref) <= CENT):
                stale.append(obs)
            else:
                fresh.append(obs)
        if stale and prev_cal_day in out:
            out[prev_cal_day]["stale_repeats"] += len(stale)
        if fresh:
            best = max(fresh, key=lambda o: o["cost_at_kill_usd"])
            out[day] = {
                "gateway_usd": best["cost_at_kill_usd"],
                "cap_usd": best["cap_usd"],
                "n_refusals": len(fresh),
                "first_observed_at": min(o["observed_at"] or "" for o in fresh),
                "last_observed_at": max(o["observed_at"] or "" for o in fresh),
                "stale_repeats": 0,
            }
    return out


def history_coverage():
    """(first_day, last_day) the history log actually covers, or (None, None).

    This is what makes a day CALIBRATABLE. Refusals reach back further than the log does
    — on the machine this was built on, back to 2026-07-26 against a log starting
    2026-08-18 — and for those earlier days our total is not a small figure, it is NO
    figure. Reporting them as maximal undercounts would inflate the headline from $290 to
    $701 and aim the investigation at an attribution bug that cannot exist where there is
    nothing to attribute.

    Keyed on the log's window rather than on "we found no records", because inside the
    window an empty day is the real structural blindness and must still be reported.
    Note that pre-coverage ledger FILES do survive on disk as 2-field `<day> 0` records,
    so a day can look populated while carrying no spend — coverage, not record count, is
    the honest discriminator.
    """
    first = last = None
    try:
        f = open(HISTORY_PATH, "r", errors="ignore")
    except OSError:
        return None, None
    with f:
        for line in f:
            parts = line.split()
            if len(parts) < 5 or not _valid_date(parts[2]):
                continue
            day = parts[2]
            if first is None or day < first:
                first = day
            if last is None or day > last:
                last = day
    return first, last


def daily_totals(days):
    """OUR figure for each of `days`: the cloud spend attributable to that UTC day.

    Deliberately built from _merged_records, the same assembly collect() reports from —
    a calibration harness that computes the total a second way would only ever prove the
    two implementations agree.
    """
    merged, _quarantined = _merged_records()
    out = {d: {"ours_usd": 0.0, "sessions_counted": 0, "reset_anchored_sessions": 0}
           for d in days}
    for (_sid, day), rec in merged.items():
        row = out.get(day)
        if row is None:
            continue
        row["ours_usd"] += rec.day_usd
        if rec.valid and rec.axis == "cloud":
            row["sessions_counted"] += 1
        if rec.reset_anchored:
            row["reset_anchored_sessions"] += 1
    for row in out.values():
        row["ours_usd"] = round(row["ours_usd"], 4)
    return out


def calibrate(max_files=500, since_days=365, tolerance=0.01):
    """Compare our daily total against the gateway's stated cumulative, day by day."""
    found = find_refusals(max_files=max_files, since_days=since_days)
    gw = gateway_totals(found["observations"])
    ours = daily_totals(sorted(gw))
    cov_first, cov_last = history_coverage()
    rows = []
    for day in sorted(gw):
        g, o = gw[day], ours[day]
        delta = round(o["ours_usd"] - g["gateway_usd"], 4)
        covered = cov_first is not None and day >= cov_first
        if not covered:
            verdict = "no-data"
        elif delta < -tolerance:
            # A refusal is a lower bound, so only ours-BELOW-gateway is a defect.
            verdict = "undercount"
        else:
            verdict = "ok"
        rows.append({
            "day": day,
            "ours_usd": o["ours_usd"],
            "gateway_usd": round(g["gateway_usd"], 4),
            "delta_usd": delta,
            "covered": covered,
            "verdict": verdict,
            # Our share of a figure the day PROVABLY reached. Once the gateway refuses,
            # the key is blocked for the rest of the budget window — and the window is the
            # UTC day — so the stated cumulative is approximately the day's FINAL total,
            # not merely a floor. The shortfall is therefore the whole error, and a ratio
            # that holds steady across days with very different session mixes is what
            # distinguishes a systematic missing component from a few absent sessions.
            "ours_pct_of_gateway": (round(100.0 * o["ours_usd"] / g["gateway_usd"], 2)
                                    if g["gateway_usd"] else None),
            "n_refusals": g["n_refusals"],
            "stale_repeats": g["stale_repeats"],
            "cap_usd": g["cap_usd"],
            "sessions_counted": o["sessions_counted"],
            "reset_anchored_sessions": o["reset_anchored_sessions"],
            "last_refusal_at": g["last_observed_at"],
        })
    under = [r for r in rows if r["verdict"] == "undercount"]
    no_data = [r for r in rows if r["verdict"] == "no-data"]
    worst = min(under, key=lambda r: r["delta_usd"]) if under else None
    # MEDIAN, not mean: one no-data-adjacent outlier should not move the headline. Only
    # calibrated days count — a day with no basis would drag the ratio toward 0% and make
    # a systematic one-fifth shortfall look like a catastrophic one.
    ratios = sorted(r["ours_pct_of_gateway"] for r in rows
                    if r["verdict"] != "no-data" and r["ours_pct_of_gateway"] is not None)
    if ratios:
        mid = len(ratios) // 2
        median_pct = (ratios[mid] if len(ratios) % 2
                      else round((ratios[mid - 1] + ratios[mid]) / 2, 2))
    else:
        median_pct = None
    out = {
        "contract": CONTRACT,
        "reference": "the gateway's own `Current cost` at a budget refusal (a LOWER bound)",
        "tolerance_usd": tolerance,
        "ledger_covers_from": cov_first,
        "ledger_covers_to": cov_last,
        "days_with_a_reference": len(rows),
        "days_calibrated": len(rows) - len(no_data),
        "no_data_days": len(no_data),
        "median_pct_of_gateway": median_pct,
        "undercount_days": len(under),
        "worst_day": worst["day"] if worst else None,
        "worst_delta_usd": worst["delta_usd"] if worst else None,
        "unaccounted_usd": round(-sum(r["delta_usd"] for r in under), 4),
        "files_scanned": found["files_scanned"],
        "days": rows,
    }
    out["measured_markup"] = measure_markup(out)
    return out


# --- rendering ----------------------------------------------------------------

def render_table(data, short_ids=True):
    """The per-session breakdown table (D16). The table IS the audit of the
    label: a reader can add the Period column themselves and see exactly which
    sessions the total is made of, instead of trusting a prose scope."""
    lines = []
    period = data["period"]
    lines.append(f"cost-tracker — period: {period} (UTC {data['period_days_utc'][0]}"
                 + (f" … {data['period_days_utc'][-1]}" if len(data['period_days_utc']) > 1 else "")
                 + ")")
    lines.append(f"membership: {data['membership']}")
    lines.append("")
    idw = 12 if short_ids else 36
    head = f"{'session':<{idw}}  {'axis':<6}  {period + ' $':>14}  {'session lifetime $':>18}"
    lines.append(head)
    lines.append("-" * len(head))
    if not data["sessions"]:
        lines.append("(no sessions in this period)")
    for sid, s in data["sessions"].items():
        sid_disp = sid[:idw] if short_ids else sid
        mark = "*" if s.get("reset_anchored") else " "
        lines.append(f"{sid_disp:<{idw}}  {s['axis']:<6}  {s['period_usd']:>13.2f}{mark}  "
                     f"{s['lifetime_usd']:>18.2f}")
    lines.append("-" * len(head))
    # The total fills ONLY the period column. A "total lifetime" would be the sum
    # of overlapping cumulatives across different sessions — a number with no
    # meaning, and exactly the kind of figure this tool refuses to print.
    lines.append(f"{'TOTAL cloud':<{idw}}  {'':<6}  {data['cloud_usd']:>14.2f}  "
                 f"{'—':>18}")
    cap = data["cap_usd"]
    markup = data.get("markup") or MARKUP_IDENTITY
    if markup != MARKUP_IDENTITY:
        # A MEASURED markup means the two axes differ, so the percentage that matters is
        # the gateway's: the cap is enforced on what the gateway bills, not on list price.
        # Reporting "75% used" off list price while the refusal is 6% away is the reassuring
        # wrong number. So the billed row leads and carries the percentage, and the cap is
        # printed as the gateway's own figure — the same one its refusal message quotes.
        # The list-price TOTAL above is NOT removed: it is the canonical recorded value and
        # the only one Claude Code itself asserts, so it stays visible and labelled.
        lines.append(f"{'billed (gw)':<{idw}}  {'':<6}  {data['billed_usd']:>14.2f}  "
                     + (f"{'(' + format(data['billed_pct_of_cap'] * 100, '.0f') + '% of cap)':>18}"
                        if cap else f"{'(×' + format(markup, '.3f') + ')':>18}"))
        if cap:
            lines.append(f"{'cap (gw)':<{idw}}  {'':<6}  {cap:>14.2f}  "
                         f"{'(×' + format(markup, '.3f') + ' applied)':>18}")
            lines.append(f"{'eff. cap':<{idw}}  {'':<6}  "
                         f"{data['effective_cap_usd']:>14.2f}  "
                         f"{'(= cap in list-price $)':>18}")
    elif cap:
        # No markup: one axis, so no qualifier is needed or honest.
        lines.append(f"{'cap':<{idw}}  {'':<6}  {cap:>14.2f}  "
                     f"{'(' + format(data['pct_of_cap'] * 100, '.0f') + '% used)':>18}")
    if markup != MARKUP_IDENTITY:
        lines.append("")
        lines.append(f"  TOTAL cloud is list price — what Claude Code says the tokens cost, "
                     f"and it is right.")
        lines.append(f"  It is the canonical recorded figure; the ×{markup:.3f} markup "
                     f"({data['markup_source']}) is stored")
        lines.append(f"  separately and applied on top, never baked into what is recorded.")
        if cap:
            lines.append(f"  Read the pair you are actually measured on: billed "
                         f"${data['billed_usd']:.2f} against the cap's ${cap:.0f} — the "
                         f"figure the")
            lines.append(f"  gateway's own refusal message quotes. `eff. cap` is that same "
                         f"cap expressed back in")
            lines.append(f"  list-price dollars (${data['effective_cap_usd']:.0f}), which is "
                         f"where TOTAL cloud runs out.")
        else:
            lines.append(f"  With no cap known, the billed figure is what the gateway "
                         f"charges; there is no denominator to print.")
    if data["local_saved_usd"] is not None:
        lines.append(f"{'local saved':<{idw}}  {'local':<6}  "
                     f"{data['local_saved_usd']:>14.2f}  "
                     f"{'(' + str(data['local_events']) + ' dispatches)':>18}")
    else:
        lines.append("local saved   local   not measured (savings ledger unavailable)")
    if data["local_sessions"]:
        lines.append(f"note: {len(data['local_sessions'])} local session(s) contribute $0 "
                     "to cloud spend by design")
    if data.get("zero_sessions"):
        lines.append(f"note: {len(data['zero_sessions'])} session(s) reported $0 with a "
                     "carried-in baseline — either a local render or a just-resumed "
                     "counter; records before 2026-08-29 cannot tell those apart, and "
                     "both are $0")
    if data.get("reset_anchored_sessions"):
        lines.append(f"* {len(data['reset_anchored_sessions'])} session(s) RESET their cost "
                     "counter mid-period (a resume), so the baseline carried in describes a "
                     "counter that no longer exists. Those figures are anchored at the reset "
                     "and are FLOORS: any spend earlier the same day, before the reset, is "
                     "not recoverable from the ledger. Subtracting the stale baseline instead "
                     "would report the day as free — `cost-tracker doctor` explains.")
    if data["quarantined"]:
        sids = {q["session_id"] or _sid_from_raw(q["raw"]) for q in data["quarantined"]}
        lines.append(f"⚠ {len(data['quarantined'])} record(s) across {len(sids)} session(s) "
                     "QUARANTINED as structurally invalid — run `cost-tracker doctor`")
    return "\n".join(lines)


def render_statusline(data):
    """The frozen one-line statusline segment.

      with a cap:    today: $37.35/$40 gw
      without a cap: today: $12.40
      with savings:  today: cloud $37.35/$40 gw · local saved $4.80

    The axis word is part of the string, not decoration: this segment coexists
    with the renderer's own session-lifetime "$<cost>", and two unlabelled
    dollar figures on one line is the mislabel trap all over again.

    BOTH figures are shown on the SAME axis, and when a markup is known that axis is
    the GATEWAY's — because the cap the user is measured against is the gateway's $40,
    and that is the number its refusal message quotes. The earlier form moved the
    denominator instead ("$30.12/$32 eff (×1.24 gw)"), which was arithmetically
    equivalent but read as a different, unexplained cap: the user sees $40 in the
    refusal and $32 here. Showing a deflated cap to keep the numerator at list price
    optimised for the wrong reader. The full four-figure breakdown (list price, billed,
    cap, effective cap) stays in `cost-tracker report`, which has room to label axes;
    this segment has one line and must therefore pick ONE axis and name it.
    """
    cap = data["cap_usd"]
    label = "today" if len(data["period_days_utc"]) == 1 else data["period"]
    markup = data.get("markup") or MARKUP_IDENTITY
    # "cloud" is a CONTRAST word: it exists to separate cloud spend from the local-inference
    # savings figure. With no local figure beside it there is nothing to contrast with, so it
    # is noise on a line that has no room for any — and a cloud session shows no savings.
    # The moment a savings figure IS present the word is load-bearing again and comes back,
    # which is the axis rule holding rather than an exception to it.
    # A ZERO savings figure is not a finding — it is the absence of one, and on this line it
    # costs the same columns as a real number while saying nothing. So the statusline treats
    # "nothing was offloaded" and "no ledger at all" identically: both omit it. `report` still
    # prints the zero row, because a table has room to say "0 dispatches" and that is
    # meaningful there. Suppressing it in one surface is not hiding state: the surface that
    # exists to enumerate is unchanged.
    saved = data["local_saved_usd"]
    if not saved:
        saved = None
    what = "cloud " if saved is not None else ""
    if cap:
        if markup != MARKUP_IDENTITY:
            # Gateway axis: the numerator is what the gateway bills, against the cap the
            # gateway actually enforces. "gw" marks the axis so the figure is never read
            # as Claude Code's own list-price total, which is the smaller number.
            seg = f"{label}: {what}${data['billed_usd']:.2f}/${cap:.0f} gw"
        else:
            # No markup: the two axes are identical, so there is nothing to name.
            seg = f"{label}: {what}${data['cloud_usd']:.2f}/${cap:.0f}"
    else:
        seg = f"{label}: {what}${data['cloud_usd']:.2f}"
    if saved is not None:
        seg += f" · local saved ${saved:.2f}"
    return seg


def render_cap(cfg, resolved, measured_today=None):
    """Show the cap AND where it came from. A cap with no provenance is a number
    someone will later have to re-derive; this prints the refusal it was read from."""
    lines = []
    env_override = None
    for var in ("COST_TRACKER_CAP_USD", "BUDGET_TALLY_CAP_USD"):
        if os.environ.get(var):
            env_override = var
            break
    if resolved is None:
        lines.append("cap: UNSET — spend is printed with no denominator, never an invented one.")
    else:
        lines.append(f"cap: ${resolved:.2f} / day")
    if env_override:
        lines.append(f"  source: ${os.environ[env_override]} from ${env_override} "
                     "(an explicit override always wins)")
    key = (cfg or {}).get("key")
    if key:
        lines.append("  learned from the gateway's own refusal:")
        lines.append(f"    Max budget:  ${key['cap_usd']:.2f}")
        lines.append(f"    at a cost of ${key['cost_at_kill_usd']:.2f} when it refused")
        lines.append(f"    scope        {key['scope']}={key['label']} {key['key_hint']}")
        lines.append(f"    observed     {key['observed_at'] or 'unknown'}")
        lines.append(f"    transcript   {key['source_file']}")
    elif cfg:
        lines.append(f"  no budget-kill message found in {cfg.get('files_scanned', 0)} "
                     "transcript(s) — nothing to learn from yet, which is a good sign.")
        lines.append(f"  last looked:   {cfg.get('learned_at', 'never')}")
    else:
        lines.append("  never looked. Run `cost-tracker cap --learn`.")
    team = (cfg or {}).get("team")
    if team:
        lines.append(f"  (also seen: the SHARED team cap ${team['cap_usd']:.2f} for "
                     f"{team['label']} — informational only, never used as a daily "
                     "denominator)")
    if resolved and measured_today is not None and measured_today > resolved:
        lines.append("")
        lines.append(f"  ⚠ today's measured spend (${measured_today:.2f}) EXCEEDS this cap "
                     "without a refusal.")
        lines.append("    Either the cap was raised, or the measurement is wrong. Re-read it "
                     "with `cost-tracker cap --learn`;")
        lines.append("    the newest refusal wins, so a raised cap is picked up the first time "
                     "the new one is hit.")
    return "\n".join(lines)


def render_calibrate(data):
    """One row per day we have external evidence for. Days without a refusal are ABSENT
    rather than 'ok': no reference means no opinion, and printing a pass there would
    dress the absence of evidence up as agreement."""
    cov = (f"{data['ledger_covers_from']} … {data['ledger_covers_to']}"
           if data["ledger_covers_from"] else "nothing (no history log)")
    lines = ["cost-tracker — calibration against the gateway's own figure",
             f"  reference: {data['reference']}",
             f"  scanned {data['files_scanned']} transcript(s); "
             f"{data['days_with_a_reference']} UTC day(s) with a refusal to check against",
             f"  our ledger covers: {cov}"
             + (f" — {data['no_data_days']} earlier day(s) have a reference but NO basis "
                f"on our side" if data["no_data_days"] else ""),
             ""]
    if not data["days"]:
        lines.append("  no refusal on record — nothing to calibrate against.")
        lines.append("  INCONCLUSIVE, not a pass: this machine has no external reference")
        lines.append("  for any day, so the daily total is unverified either way.")
        return "\n".join(lines)

    lines.append(f"  {'day':<12}{'ours':>10}{'gateway':>11}{'delta':>10}  "
                 f"{'sess':>4} {'kills':>5}  verdict")
    lines.append("  " + "-" * 62)
    for r in data["days"]:
        flag = {"undercount": "UNDERCOUNT", "no-data": "no data (pre-ledger)"}.get(
            r["verdict"], "ok")
        note = ""
        if r["reset_anchored_sessions"]:
            note = f"  (floor: {r['reset_anchored_sessions']} resumed)"
        # A no-data day has no delta worth printing: the zero is an absent source, not a
        # measurement, and a printed -40.09 reads as a finding.
        ours = "     —" if r["verdict"] == "no-data" else f"{r['ours_usd']:>10.2f}"
        delta = "        —" if r["verdict"] == "no-data" else f"{r['delta_usd']:>+10.2f}"
        lines.append(f"  {r['day']:<12}{ours:>10}{r['gateway_usd']:>11.2f}"
                     f"{delta:>10}  {r['sessions_counted']:>4} "
                     f"{r['n_refusals']:>5}  {flag}{note}")
    lines.append("  " + "-" * 62)
    if data["undercount_days"]:
        lines.append(f"  {data['undercount_days']} of {data['days_calibrated']} calibrated "
                     f"UNDERCOUNT — ${data['unaccounted_usd']:.2f} of real spend never "
                     f"reached our total.")
        lines.append(f"  worst: {data['worst_day']} at ${data['worst_delta_usd']:.2f}.")
        if data["median_pct_of_gateway"] is not None:
            lines.append(f"  we report a median {data['median_pct_of_gateway']:.1f}% of "
                         f"what the gateway charged.")
            lines.append("  A refusal BLOCKS the key for the rest of the window, so that "
                         "figure is very nearly")
            lines.append("  the day's FINAL total — the gap is the error itself, not a "
                         "bound on it. A ratio")
            lines.append("  this steady across different session mixes means a systematic "
                         "missing component,")
            lines.append("  not a few sessions that got away.")
        lines.append("  Do NOT close the gap by scaling or clamping OUR figure: every "
                     "previous version of")
        lines.append("  this bug agreed with itself, and only this external reference "
                     "catches it.")
    else:
        lines.append(f"  every calibrated day agrees with the gateway "
                     f"(tolerance ${data['tolerance_usd']:.2f}).")

    # The resolution of the long-running "20% undercount": it was never OUR arithmetic.
    m = data.get("measured_markup") or {}
    if m.get("n_days"):
        lines.append("")
        lines.append(f"  gateway markup: this account's gateway billed a median "
                     f"×{m['factor']:.4f} of list")
        lines.append(f"    price over {m['n_days']} calibrated day(s) "
                     f"(range ×{m['ratio_min']:.3f}-×{m['ratio_max']:.3f}"
                     + (f", CV {m['cv']:.3f}" if m.get("cv") is not None else "") + ").")
        if m.get("reason"):
            lines.append(f"    NOT learned: {m['reason']}.")
        else:
            lines.append("    Steady enough to be a RATE rather than a scatter, so it can "
                         "be recorded as a")
            lines.append("    second axis: `cost-tracker calibrate --learn-markup`. Our own "
                         "total is left")
            lines.append("    exactly as measured; what the markup changes is the "
                         "DENOMINATOR — how much")
            lines.append("    of the cap a dollar of list price actually consumes.")
    return "\n".join(lines)


def render_markup(cfg, resolved):
    """Show the markup, its provenance, and — when there is none — WHY that is correct.

    The empty state carries the finding. Someone on a plain Anthropic account should read
    this and stop, rather than go looking for the missing 20% that isn't theirs to find.
    """
    lines = []
    env = os.environ.get("COST_TRACKER_MARKUP")
    if resolved == MARKUP_IDENTITY:
        lines.append("gateway markup: NONE (×1.0) — spend is reported at Anthropic list "
                     "price.")
    else:
        lines.append(f"gateway markup: ×{resolved:.4f} — this account's gateway bills that "
                     f"much per")
        lines.append("  dollar of list price.")
    if env:
        lines.append(f"  source: ×{env} from $COST_TRACKER_MARKUP (an explicit override "
                     "always wins)")
    m = (cfg or {}).get("markup")
    if m:
        lines.append(f"  basis:       {m.get('basis', 'unknown')}")
        if m.get("n_days"):
            lines.append(f"  measured on: {m['n_days']} calibrated UTC day(s)"
                         + (f", CV {m['cv']:.3f}" if m.get("cv") is not None else ""))
        if m.get("ratio_min") and m.get("ratio_max"):
            lines.append(f"  per-day range: ×{m['ratio_min']:.3f} … ×{m['ratio_max']:.3f}")
        lines.append(f"  recorded:    {m.get('measured_at', 'unknown')}")
    elif not env:
        lines.append("  Nothing has been measured, and on a normal Claude Code account "
                     "nothing ever will")
        lines.append("  be: a markup can only be learned from a GATEWAY refusal message, "
                     "which a")
        lines.append("  first-party account never produces. This is the correct and "
                     "expected state.")
    lines.append("")
    lines.append("what this is for")
    lines.append("  Claude Code's own `total_cost_usd` prices tokens at Anthropic LIST "
                 "rates, and it")
    lines.append("  is accurate: reconstructing a session from its own usage records "
                 "reproduces that")
    lines.append("  figure to within a rounding error. cost-tracker reports it faithfully "
                 "and does")
    lines.append("  not recompute it.")
    lines.append("")
    lines.append("  A RESELLING gateway (LiteLLM and similar) can still bill a different "
                 "amount for")
    lines.append("  the same tokens. Then our total is right about cost and wrong as a "
                 "predictor of")
    lines.append("  the refusal — which is the only number that actually stops the work. "
                 "The markup")
    lines.append("  is that second axis. It never edits our figure; it moves the "
                 "DENOMINATOR, so the")
    lines.append("  cap is expressed in the units we can actually measure.")
    lines.append("")
    lines.append("  Measured once, so nobody repeats the investigation: on the gateway "
                 "this was")
    lines.append("  built against, the factor was ~×1.23 and steady (19 days, "
                 "×1.205-×1.289, CV")
    lines.append("  0.053) — a multiplicative model fit ~4x tighter than an additive one, "
                 "which is")
    lines.append("  what rules out a fixed per-day fee. With a $40 cap that puts the real "
                 "ceiling")
    lines.append("  near $32 of list-price spend, matching every observed kill day. Ruled "
                 "out along")
    lines.append("  the way: day-boundary misattribution, missing sessions, a long-context "
                 "premium")
    lines.append("  (there is none), tokenizer inflation, and a second consumer of the key.")
    lines.append("")
    lines.append("  Your gateway's factor is its own. Run `cost-tracker calibrate "
                 "--learn-markup`")
    lines.append("  once you have a few refusals on record; it refuses to learn a factor "
                 "the")
    lines.append("  evidence does not support.")
    return "\n".join(lines)


def render_doctor(data):
    lines = [f"cost-tracker doctor — ledger dir: {LEDGER_DIR}",
             f"                     history:    {HISTORY_PATH}",
             f"today (UTC): {data['today_utc']}   cap: "
             + (f"${data['cap_usd']:.2f}" if data["cap_usd"] else "unset (no denominator printed)")
             + f"   [{data.get('cap_source') or 'unset'}]"]
    lines.append("")
    if data.get("reset_anchored_sessions"):
        lines.append("COUNTER RESETS (a resumed session) — %d in this period:"
                     % len(data["reset_anchored_sessions"]))
        for sid in data["reset_anchored_sessions"]:
            s = data["sessions"][sid]
            lines.append(f"  {sid}  ${s['period_usd']:.2f}  days {','.join(s['days'])}")
        lines.append("")
        lines.append("  Claude Code's total_cost_usd restarts at 0 when a session is RESUMED, so")
        lines.append("  the cumulative can fall BELOW the baseline carried into the day. The")
        lines.append("  baseline then describes a counter that no longer exists. Subtracting it")
        lines.append("  gives a negative number, and clamping that to 0 reports the day as free:")
        lines.append("  measured on session e4d10d09, 2026-08-26 — $16.07 of real spend reported")
        lines.append("  as $0.00. These figures are anchored at the reset instead, which makes")
        lines.append("  them FLOORS: spend earlier the same day, before the reset, is gone from")
        lines.append("  the ledger. A reset that later climbs back above the stale baseline is")
        lines.append("  invisible in the final record and is detected from the row sequence.")
        lines.append("")
    if data.get("zero_sessions"):
        lines.append("AMBIGUOUS ZEROS — %d session(s) reported $0 against a carried-in baseline."
                     % len(data["zero_sessions"]))
        lines.append("  Either a local render (the endpoint gate zeroes the cost) or a resumed")
        lines.append("  counter that has not billed yet. Field 4 tells them apart and did not")
        lines.append("  exist before 2026-08-29, so older records are reported as `zero` rather")
        lines.append("  than asserted to be local. Both contribute $0 either way.")
        lines.append("")
    q = data["quarantined"]
    if not q:
        lines.append("No quarantined records. Every record parsed as a valid session-day.")
        return "\n".join(lines)
    # GROUPED by (reason, session): one bad session renders its statusline hundreds
    # of times, so an ungrouped list is 131 near-identical lines that hide the fact
    # that only two sessions are affected. The count is the volume; the group is the
    # finding.
    groups = defaultdict(lambda: {"n": 0, "example": "", "sources": set()})
    for item in q:
        key = (item["reason"], item["session_id"] or _sid_from_raw(item["raw"]))
        g = groups[key]
        g["n"] += 1
        g["sources"].add(item["source"].split(":")[0])
        if not g["example"]:
            g["example"] = item["raw"]
    lines.append(f"{len(q)} QUARANTINED record(s) in {len(groups)} group(s) — each counted "
                 "as $0 and excluded from every figure, never silently dropped:")
    for (reason, sid), g in sorted(groups.items(), key=lambda kv: -kv[1]["n"]):
        lines.append(f"  [{reason}] session {sid or '(unknown)'} — {g['n']} record(s) "
                     f"in {'+'.join(sorted(g['sources']))}")
        lines.append(f"      e.g. {g['example'][:140]!r}")
    return "\n".join(lines)


def _sid_from_raw(raw):
    """A history line carries its session id in field 2; the ledger record does not
    carry one at all (the FILENAME is the id, which the caller already passed)."""
    parts = raw.split()
    return parts[1] if len(parts) > 1 and "T" in parts[0] else ""


def main(argv=None):
    ap = argparse.ArgumentParser(
        prog="cost-tracker",
        description="Report Claude Code spend on three labelled axes: session, today, local.")
    sub = ap.add_subparsers(dest="cmd")

    def add_period(p):
        g = p.add_mutually_exclusive_group()
        g.add_argument("--today", action="store_const", const="today", dest="period")
        g.add_argument("--week", action="store_const", const="week", dest="period")
        g.add_argument("--month", action="store_const", const="month", dest="period")
        p.add_argument("--since", metavar="YYYY-MM-DD")
        p.add_argument("--json", action="store_true")
        p.set_defaults(period="today")

    rep = sub.add_parser("report", help="per-session breakdown table for a period")
    add_period(rep)
    rep.add_argument("--full-ids", action="store_true", help="print full session UUIDs")

    st = sub.add_parser("statusline", help="one-line statusline segment (today)")
    st.add_argument("--json", action="store_true")
    st.add_argument("--fast", action="store_true",
                    help="skip the history log and read savings from the derived rollup; "
                         "for the per-render statusline path")

    doc = sub.add_parser("doctor", help="show quarantined records and resolved config")
    doc.add_argument("--json", action="store_true")

    cal = sub.add_parser("calibrate",
                         help="check our daily totals against the gateway's own figure")
    cal.add_argument("--json", action="store_true")
    cal.add_argument("--since-days", type=int, default=365, dest="since_days",
                     help="how far back to look for refusals (default 365)")
    cal.add_argument("--tolerance", type=float, default=0.01, metavar="USD",
                     help="ignore gaps smaller than this (default 0.01)")
    cal.add_argument("--learn-markup", action="store_true", dest="learn_markup",
                     help="record the measured gateway markup so it does not have to be "
                          "re-derived (refused unless the per-day ratios are steady)")

    mk = sub.add_parser("markup", help="show the gateway markup and where it came from")
    mk.add_argument("--set", metavar="FACTOR", dest="set_markup",
                    help="record a factor by hand (1 = none)")
    mk.add_argument("--clear", action="store_true",
                    help="forget the learned markup and go back to list price only")
    mk.add_argument("--json", action="store_true")

    cp = sub.add_parser("cap", help="show the daily cap and where it came from")
    cp.add_argument("--learn", action="store_true",
                    help="re-read the cap from the newest budget-kill message now "
                         "(run this when the daily budget cap has changed)")
    cp.add_argument("--set", metavar="USD", dest="set_cap",
                    help="record a cap by hand instead of learning one")
    cp.add_argument("--json", action="store_true")

    args = ap.parse_args(argv)
    cmd = args.cmd or "report"
    if cmd == "report" and args.cmd is None:
        args = ap.parse_args(["report"] + (argv or []))

    since = getattr(args, "since", None)
    if since:
        try:
            date.fromisoformat(since)
        except ValueError:
            ap.error("--since needs a YYYY-MM-DD date")

    if cmd == "calibrate":
        data = calibrate(since_days=args.since_days, tolerance=args.tolerance)
        if getattr(args, "learn_markup", False):
            m = data.get("measured_markup") or {}
            if m.get("factor") and not m.get("reason"):
                cfg = read_config() or {"contract": CONTRACT}
                cfg["markup"] = {
                    "factor": m["factor"],
                    "n_days": m["n_days"], "cv": m.get("cv"),
                    "ratio_min": m.get("ratio_min"), "ratio_max": m.get("ratio_max"),
                    "measured_at": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
                    "basis": ("median per-day gateway/ours ratio over calibrated days, "
                              "from the gateway's own `Current cost` at refusals"),
                }
                if write_config(cfg):
                    print(f"cost-tracker: recorded a gateway markup of "
                          f"×{m['factor']:.4f} from {m['n_days']} day(s).")
                else:
                    print(f"cost-tracker: could not write {CONFIG_PATH}", file=sys.stderr)
            else:
                # Refusing to learn is a RESULT, not a failure: identity stays in force.
                print("cost-tracker: no markup recorded — "
                      + (m.get("reason") or "no evidence to measure one from")
                      + ".", file=sys.stderr)
        if args.json:
            print(json.dumps(data, indent=2, sort_keys=True))
        else:
            print(render_calibrate(data))
        # Nonzero on a measured undercount so this can GATE a release rather than being
        # a report nobody reads. No refusal on record is INCONCLUSIVE, and exits 0.
        return 1 if data["undercount_days"] else 0

    if cmd == "markup":
        if args.set_markup:
            try:
                v = float(args.set_markup)
            except ValueError:
                ap.error("--set needs a number")
            if v <= 0:
                ap.error("--set needs a positive number")
            cfg = read_config() or {"contract": CONTRACT}
            if v == MARKUP_IDENTITY:
                cfg.pop("markup", None)
            else:
                cfg["markup"] = {
                    "factor": v, "n_days": 0, "cv": None,
                    "measured_at": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
                    "basis": "set by hand with `cost-tracker markup --set`",
                }
            if not write_config(cfg):
                print(f"cost-tracker: could not write {CONFIG_PATH}", file=sys.stderr)
        elif args.clear:
            cfg = read_config() or {}
            if cfg.pop("markup", None) is not None and not write_config(cfg):
                print(f"cost-tracker: could not write {CONFIG_PATH}", file=sys.stderr)
        cfg = read_config()
        resolved = markup_factor()
        if args.json:
            print(json.dumps({"contract": CONTRACT, "markup": resolved,
                              "is_identity": resolved == MARKUP_IDENTITY,
                              "config_path": CONFIG_PATH,
                              "config": (cfg or {}).get("markup")},
                             indent=2, sort_keys=True))
            return 0
        print(render_markup(cfg, resolved))
        return 0

    if cmd == "cap":
        if args.set_cap:
            try:
                manual = float(args.set_cap)
            except ValueError:
                ap.error("--set needs a number")
            if manual <= 0:
                ap.error("--set needs a positive number")
            cfg = read_config() or {"contract": 1}
            cfg["key"] = {
                "cap_usd": manual, "cost_at_kill_usd": 0.0, "scope": "key",
                "label": "(set by hand)", "key_hint": "",
                "observed_at": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
                "source_file": "(manual)",
                "raw": "set by hand with `cost-tracker cap --set`",
            }
            cfg["found"] = True
            cfg["learned_at"] = datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
            if not write_config(cfg):
                print(f"cost-tracker: could not write {CONFIG_PATH}", file=sys.stderr)
                return 0
        elif args.learn:
            cfg = learn_cap()
            write_config(cfg)
        else:
            cfg = read_config()
        resolved = cap_usd()
        if args.json:
            print(json.dumps({"contract": CONTRACT, "cap_usd": resolved,
                              "config_path": CONFIG_PATH, "config": cfg},
                             indent=2, sort_keys=True))
            return 0
        measured = collect("today", fast=True)["cloud_usd"]
        print(render_cap(cfg, resolved, measured_today=measured))
        return 0

    period = getattr(args, "period", "today")
    data = collect(period, since, fast=getattr(args, "fast", False))

    if getattr(args, "json", False):
        print(json.dumps(data, indent=2, sort_keys=True))
        return 0
    if cmd == "statusline":
        print(render_statusline(data))
    elif cmd == "doctor":
        print(render_doctor(data))
    else:
        print(render_table(data, short_ids=not getattr(args, "full_ids", False)))
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except BrokenPipeError:
        sys.exit(0)
    except Exception as e:               # a reporting bug must never break a caller
        print(f"cost-tracker: skipped ({e})", file=sys.stderr)
        sys.exit(0)
